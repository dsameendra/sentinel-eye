# Local credentials and cryptographic material.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
secrets*.json

# Recorder state and captured/exported media.
*.db
*.db-*
*.sqlite
*.sqlite-*
captures/
exports/
# Stray clips anywhere in the tree (camera footage).
*.mp4
*.mkv
recordings/
snapshots/
thumbnails/

bin/go2rtc
*.log
.venv/
data/
__pycache__/
*.pyc
.DS_Store
# facexlib (a GFPGAN dependency — docs/playback-spec.md section 7.8) downloads its face-detection/parsing
# weights to ./gfpgan/weights relative to the server's cwd, not somewhere configurable — a few hundred MB
# that should never land in the repo.
/gfpgan/
# impeccable's per-session edit-tracking cache — local, keyed by session id, not shared project state.
.impeccable/hook.cache.json

# ./run.sh backup output (contains credentials).
backups/

# Generated by run.sh for GPU passthrough.
compose.gpu.yaml
